        {
          "prom_ql": "disk_used_percent{fstype=~\"ext4|xfs|btrfs\",path!~\"/boot|/boot/efi\"} > 95",
          "severity": 1
        }
      ]
    },
    "datasource_ids": [],
    "algorithm": "",
    "algo_params": null,
