        {
          "prom_ql": "100 * disk_inodes_used{fstype=~\"ext4|xfs|btrfs\"} / clamp_min(disk_inodes_total{fstype=~\"ext4|xfs|btrfs\"}, 1) > 80",
          "severity": 2
        }
      ]
    },
    "datasource_ids": [],
    "algorithm": "",
    "algo_params": null,
    "delay": 0,
    "cluster": ""
  },
