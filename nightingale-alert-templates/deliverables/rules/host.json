  {
    "cate": "prometheus",
    "prod": "metric",
    "name": "磁盘 inode 使用率过高",
    "note": "inodes used above 80 percent. A full inode table blocks creates even when df still shows bytes free.",
    "disabled": 0,
    "prom_for_duration": 600,
    "prom_eval_interval": 30,
    "prom_ql": "100 * disk_inodes_used{fstype=~\"ext4|xfs|btrfs\"} / clamp_min(disk_inodes_total{fstype=~\"ext4|xfs|btrfs\"}, 1) > 80",
    "severity": 2,
    "enable_stime": "00:00",
    "enable_etime": "23:59",
    "enable_days_of_week": [
      "1",
      "2",
