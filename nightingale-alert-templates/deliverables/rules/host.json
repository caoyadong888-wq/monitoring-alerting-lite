[
  {
    "cate": "prometheus",
    "prod": "metric",
    "name": "主机 CPU 使用率过高",
    "note": "cpu_usage_active stays above 85 percent (warning) or 95 percent (critical). Categraf cpu plugin, cpu=cpu-total.",
    "disabled": 0,
    "prom_for_duration": 300,
    "prom_eval_interval": 30,
    "prom_ql": "avg by (ident) (cpu_usage_active{cpu=\"cpu-total\"}) > 85",
    "severity": 2,
    "enable_stime": "00:00",
    "enable_etime": "23:59",
    "enable_days_of_week": [
      "1",
      "2",
      "3",
      "4",
      "5",
      "6",
      "0"
    ],
    "enable_in_bg": 0,
    "notify_recovered": 1,
    "notify_channels": [],
    "notify_groups": [],
    "notify_repeat_step": 15,
    "notify_max_number": 0,
    "recover_duration": 180,
    "callbacks": [],
    "runbook_url": "https://ops.example.com/runbooks/n9e-host#host-cpu",
    "append_tags": [
      "service=host",
      "pack=nightingale-alert-templates"
    ],
    "annotations": {
      "summary": "Host CPU is high on {{$labels.ident}} (value {{$value}})",
      "summary_zh": "主机 {{$labels.ident}} 的 CPU 使用率过高（当前 {{$value}}）",
      "description": "cpu_usage_active for cpu-total has been above the threshold for 5 minutes.",
      "description_zh": "cpu-total 的 cpu_usage_active 已连续 5 分钟高于阈值。"
    },
    "rule_config": {
      "inhibit": true,
      "queries": [
        {
          "prom_ql": "avg by (ident) (cpu_usage_active{cpu=\"cpu-total\"}) > 85",
          "severity": 2
        },
        {
          "prom_ql": "avg by (ident) (cpu_usage_active{cpu=\"cpu-total\"}) > 95",
          "severity": 1
        }
      ]
    },
    "datasource_ids": [],
    "algorithm": "",
    "algo_params": null,
    "delay": 0,
    "cluster": ""
  },
